# A free name pointing at your home/server IP, e.g. from duckdns.org
DOMAIN=myreelbox.duckdns.org
# Your Xtream server as seen from this machine.
# Same machine as Docker → http://host.docker.internal:PORT
XTREAM_URL=http://host.docker.internal:8080
# Family account server (monorepo apps/api on Vercel). Optional; enables sign-in + sync.
VITE_API_URL=https://your-api.vercel.app
