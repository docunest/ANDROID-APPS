<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="home_bg">#FFF6E0</color>
    <color name="launcher_bg">#FFB300</color>

    <style name="Theme.Ponas" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/home_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:colorAccent">#FF8F00</item>
    </style>

    <style name="Theme.Ponas.Game">
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
