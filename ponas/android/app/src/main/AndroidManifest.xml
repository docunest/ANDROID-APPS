<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network, and installing the app's own updates (same as the dock). Ask the parent before adding any other. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Normal permission (Android 12+): lets the self-update install without a tap. -->
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

    <!-- Fake GPS (owner-approved 2026-11-25): the tablet has no GPS chip, so Ponas is Android's mock
         location app and feeds the family's position from MapPal to every app (FakeGps.kt). -->
    <uses-permission
        android:name="android.permission.ACCESS_MOCK_LOCATION"
        tools:ignore="MockLocation,ProtectedPermissions" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Package visibility for the parent menu's "normal launcher" and the Camera tile. -->
    <queries>
        <package android:name="com.android.launcher3" />
        <package android:name="com.softwinner.camera2" />
        <!-- Apps the parent can put on the home screen (AppShortcuts): every app with a launcher icon. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Ponas"
        android:usesCleartextTraffic="false">

        <meta-data
            android:name="android.webkit.WebView.MetricsOptOut"
            android:value="true" />

        <activity
            android:name=".HomeActivity"
            android:clearTaskOnLaunch="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="false"
            android:screenOrientation="fullUser"
            android:stateNotNeeded="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Result of a self-update install (Updater). Not exported. -->
        <receiver
            android:name=".UpdateReceiver"
            android:exported="false" />

        <!-- Fake GPS: feeds the mock location every second (FakeGps.kt). -->
        <service
            android:name=".FakeGpsService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Mock location for a tablet without a GPS chip" />
        </service>

        <!-- Sets the MapPal position token; DUMP means only the adb shell can send it. -->
        <receiver
            android:name=".FakeGpsReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="lt.eb07.ponas.SET_POSITION_TOKEN" />
            </intent-filter>
        </receiver>

        <!-- Parent-only (opened after the PIN). -->
        <activity
            android:name=".InstallActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|uiMode"
            android:exported="false"
            android:screenOrientation="fullUser" />

        <!-- Each game runs in its own ":game" process, which is ended when the game closes,
             so every game starts in a fresh browser with nothing left over from the last one. -->
        <activity
            android:name=".GameActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|uiMode"
            android:exported="false"
            android:process=":game"
            android:resizeableActivity="false"
            android:screenOrientation="fullUser"
            android:theme="@style/Theme.Ponas.Game" />
    </application>
</manifest>
